<script>
    jQuery(document).on("scroll", function () {
        var pageTop = jQuery(document).scrollTop()
        var pageBottom = pageTop + jQuery(window).height()
        var tags = jQuery(".shadowItem")

        for (var i = 0; i < tags.length; i++) {
            var tag = tags[i]

            if (jQuery(tag).position().top < pageBottom) {
                jQuery(tag).addClass("visible")
            } //else {
            //$(tag).removeClass("visible")
            //}
        }


    })


    jQuery(document).ready(function () {

        var pageTop = jQuery(document).scrollTop()
        var pageBottom = pageTop + jQuery(window).height()
        var tags = jQuery(".shadowItem")

        for (var i = 0; i < tags.length; i++) {
            var tag = tags[i]

            if (jQuery(tag).position().top < pageBottom) {
                jQuery(tag).addClass("visible")
            } //else {
            //$(tag).removeClass("visible")
            //}
        }
    })


</script>



<script>

    jQuery('.imageHolderNew')
        // tile mouse actions
        .on('mouseover', function () {
            jQuery(this).children('div').css({'transform': 'scale(2.2)'});
        })
        .on('mouseout', function () {
            jQuery(this).children('div').css({'transform': 'scale(1)'});
        })
        .on('mousemove', function (e) {
            jQuery(this).children('div').css({'transform-origin': ((e.pageX - $(this).offset().left) / jQuery(this).width()) * 100 + '% ' + ((e.pageY - $(this).offset().top) / jQuery(this).height()) * 100 + '%'});
        })
</script>

<script src='https://shared9.kwikweb.co.za/shared/apps/file_library//skrollr.min.js'></script>
<script type="text/javascript">


    jQuery(function () {
        // initialize skrollr if the window width is large enough
        if ($(window).width() > 767) {
            var s = skrollr.init();

        }

        if (s.isMobile()) {
            s.destroy();

        }

        // disable skrollr if the window is resized below 768px wide
        jQuery(window).on('resize', function () {

            if ($(window).width() <= 767) {
                skrollr.init().destroy(); // skrollr.init() returns the singleton created above
                console.log('skroll Destroyed - Mobile');
            }
        });
    });

</script>




