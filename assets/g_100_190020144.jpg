    function sendmail_business()
    {

        var captchaValue = parseInt(document.getElementById('value').value) + 80;
        if (document.getElementById('answer').value != captchaValue)
        {
            document.getElementById("Quick_div").innerHTML = "Please try again<br/>Complete all fields & answer the question correctly.<br/><input type=\"button\" name=\"button\" id=\"button\" value=\"Close Window\"  onclick=\"window.location.reload();\" /> ";
        }
        else
        {
            //changed
            //alert("test");
            $.get('/quick_email_business.php?companycode=eagletowing&id=' + gets('businessid') + '&name=' + gets('qname') + '&email=' + gets('qemail') + ',' + gets('comp_email') + '&notes=' + gets('qnotes') + '&tel=' + gets('qtel'));
            
            $('#Quick_div').html("'Your enquiry has been sent.<br/> A copy has been sent to the email you supplied.<br/><br/><br/><input type=\"button\" name=\"button\" id=\"button\" value=\"Close Window\"  onclick=\"window.location.reload();\" />");
        }
    }

    function loadBox_business(businessID)
    {
        Boxy.load("/quick_ref_business.php?businessid=" + businessID + "&companycode=" + "eagletowing");
    }

    function showPopup(element, msg)
    {
        $(element).HideBubblePopup();
        $(element).CreateBubblePopup({
            innerHtml: msg, themePath: '../../shared//apps/file_library/jquerybubblepopup-theme',
            position: 'top',
            themeName: 'all-blue',
            alwaysVisible: 'true'
        });
    }

    function gets(id)
    {
        return $('#' + id).val();
